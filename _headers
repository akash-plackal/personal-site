/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Speculation-Rules: "/speculationrules.json"
  Cache-Control: public, max-age=60, stale-while-revalidate=86400, stale-if-error=604800
  X-Robots-Tag: index, follow

/
  Link: </assets/hero-avatar-384.avif>; rel=preload; as=image; type=image/avif; imagesrcset="/assets/hero-avatar-384.avif 384w, /assets/hero-avatar-640.avif 640w"; imagesizes="(min-width: 94.75rem) 18rem, (min-width: 57.9rem) 19vw, 11rem"
  Link: <https://giscus.app>; rel=preconnect; crossorigin

/about/
  Link: </assets/hero-about-720.avif>; rel=preload; as=image; type=image/avif

/articles/*
  Link: <https://giscus.app>; rel=preconnect; crossorigin

# Pages merges every matching block, joining repeated headers with ", ".
# `! Cache-Control` detaches the /* value so a block's own policy stands alone.
# speculationrules.json is deliberately left on the /* (HTML) policy: it is
# named by fixed path in the Speculation-Rules header, so it must never be
# immutable.
/speculationrules.json
  Content-Type: application/speculationrules+json

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
